# Copy to .env and fill in. Never commit .env.

# SQLite file for app state (attempts, events). Defaults to ./sql_mitra.db
# DATABASE_URL=sqlite:///./sql_mitra.db

# AI mentor (OpenRouter). If either value is missing, the app uses canned
# Telugu-English messages instead. Pick a model id from https://openrouter.ai/models
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# AI_TIMEOUT_SECONDS=20
